// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GYM_OWNER
  CLIENT
}

enum SalleStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
enum DefiStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}
enum UserDefiStatus {
  INVITED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum BadgeType {
  CHALLENGE_COMPLETION
  STREAK
  MILESTONE
  SPECIAL
}

model User {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  password_hash       String
  first_name          String
  last_name           String
  role                Role     @default(CLIENT)
  profile_picture_url String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  is_active           Boolean  @default(true)
  player_score        Int      @default(0)

  // Relations
  owned_salles        Salle[]  @relation("SalleOwner")
  approved_salles     Salle[]  @relation("SalleApprover")
  created_defis       Defi[]               @relation("DefiCreator")
  defi_participations UserDefi[]
  workout_sessions    WorkoutSession[]
  created_badges      Badge[]             @relation("BadgeCreator")




  @@map("users")
}

model Salle {
  id             Int          @id @default(autoincrement())
  owner_id       Int
  name           String
  address        String
  city           String
  postal_code    String
  contact_phone  String
  contact_email  String
  description    String       @db.Text
  capacity       Int
  status         SalleStatus  @default(PENDING)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  approved_by    Int?
  approved_at    DateTime?

  // Relations
  owner          User         @relation("SalleOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  approver       User?        @relation("SalleApprover", fields: [approved_by], references: [id], onDelete: SetNull)
  gym_equipments GymEquipment[]
  gym_exercice_types  GymExerciceType[]
  defis               Defi[]
  workout_sessions    WorkoutSession[]



  @@map("salles")
}

model Equipment {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  image_url   String?
  created_at  DateTime @default(now())

  // Relations
  gym_equipments GymEquipment[]

  @@map("equipments")
}

model GymEquipment {
  id           Int       @id @default(autoincrement())
  gym_id       Int
  equipment_id Int
  quantity     Int       @default(1)

  // Relations
  gym          Salle     @relation(fields: [gym_id], references: [id], onDelete: Cascade)
  equipment    Equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade)

  @@unique([gym_id, equipment_id])
  @@map("gym_equipments")
}

model ExerciceType {
  id               Int             @id @default(autoincrement())
  name             String          @unique
  description      String          @db.Text
  difficulty_level DifficultyLevel
  targeted_muscles String          @db.Text
  calories_per_hour Int
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  // Relations
  gym_exercice_types  GymExerciceType[]
  defi_exercises      DefiExercice[]
  workout_exercises   WorkoutExercice[]



  @@map("exercice_types")
}

model GymExerciceType {
  id                Int           @id @default(autoincrement())
  gym_id            Int
  exercice_type_id  Int

  // Relations
  gym               Salle         @relation(fields: [gym_id], references: [id], onDelete: Cascade)
  exercice_type     ExerciceType  @relation(fields: [exercice_type_id], references: [id], onDelete: Cascade)

  @@unique([gym_id, exercice_type_id])
  @@map("gym_exercice_types")
}

model Defi {
  id                Int             @id @default(autoincrement())
  creator_id        Int
  gym_id            Int?
  title             String
  description       String          @db.Text
  difficulty_level  DifficultyLevel
  duration_days     Int
  start_date        DateTime?
  end_date          DateTime?
  is_collaborative  Boolean         @default(false)
  target_calories   Int?
  status            DefiStatus      @default(DRAFT)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  // Relations
  creator           User            @relation("DefiCreator", fields: [creator_id], references: [id], onDelete: Cascade)
  gym               Salle?          @relation(fields: [gym_id], references: [id], onDelete: SetNull)
  exercises         DefiExercice[]
  participants      UserDefi[]
  workout_sessions  WorkoutSession[]



  @@map("defis")
}

model DefiExercice {
  id                      Int           @id @default(autoincrement())
  challenge_id            Int
  exercise_type_id        Int
  target_repetitions      Int?
  target_duration_minutes Int?
  order_index             Int

  // Relations
  challenge               Defi          @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  exercise_type           ExerciceType  @relation(fields: [exercise_type_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, exercise_type_id])
  @@map("defi_exercices")
}
model UserDefi {
  id                   Int             @id @default(autoincrement())
  user_id              Int
  challenge_id         Int
  status               UserDefiStatus  @default(INVITED)
  progress_percentage  Decimal         @default(0) @db.Decimal(5, 2)
  joined_at            DateTime        @default(now())
  completed_at         DateTime?

  // Relations
  user                 User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge            Defi            @relation(fields: [challenge_id], references: [id], onDelete: Cascade)

  @@unique([user_id, challenge_id])
  @@map("user_defis")
}
model WorkoutSession {
  id               Int       @id @default(autoincrement())
  user_id          Int
  challenge_id     Int?
  gym_id           Int?
  session_date     DateTime
  duration_minutes Int
  calories_burned  Int
  notes            String?   @db.Text
  created_at       DateTime  @default(now())

  // Relations
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge        Defi?     @relation(fields: [challenge_id], references: [id], onDelete: SetNull)
  gym              Salle?    @relation(fields: [gym_id], references: [id], onDelete: SetNull)
  exercises        WorkoutExercice[]


  @@index([user_id])
  @@index([challenge_id])
  @@index([gym_id])
  @@index([session_date])
  @@map("workout_sessions")
}
model WorkoutExercice {
  id                  Int              @id @default(autoincrement())
  workout_session_id  Int
  exercise_type_id    Int
  repetitions         Int?
  duration_minutes    Int?
  weight_kg           Decimal?         @db.Decimal(5, 2)

  // Relations
  workout_session     WorkoutSession   @relation(fields: [workout_session_id], references: [id], onDelete: Cascade)
  exercise_type       ExerciceType     @relation(fields: [exercise_type_id], references: [id], onDelete: Cascade)

  @@index([workout_session_id])
  @@index([exercise_type_id])
  @@map("workout_exercices")
}
model Badge {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String    @db.Text
  image_url   String
  badge_type  BadgeType
  created_by  Int
  created_at  DateTime  @default(now())

  // Relations
  creator     User        @relation("BadgeCreator", fields: [created_by], references: [id], onDelete: Cascade)


  @@index([badge_type])
  @@index([created_by])
  @@map("badges")
}